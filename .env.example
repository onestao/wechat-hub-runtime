# Ports
HTTP_PORT=3000
HTTPS_PORT=3001

# User/Group
PUID=1000
PGID=100

# Selkies Web UI
# CUSTOM_USER=
# PASSWORD=

# Shared Memory
SHM_SIZE=1gb

# WeChat Startup
# AUTO_START_WECHAT=true

# Multi-account WeChat Runtime
# Empty keeps the upstream-compatible default account on abc + /config.
# WECHAT_ACCOUNTS=default,work,personal
# WECHAT_DEFAULT_ACCOUNT_ID=default
# WECHAT_ACCOUNT_UID_BASE=20000
# WECHAT_ACCOUNT_DISPLAY_MAP=work=:1,personal=:1
# WECHAT_LEGACY_DEFAULT_ACCOUNT=true
# WECHAT_ACCOUNTS_FILE=/config/wechat-runtime/accounts.json
# WECHAT_ACCOUNT_HOME_ROOT=/config/wechat-accounts

# Nightly WeChat Restart Schedule
# ENABLE_WECHAT_NIGHTLY_RESTART=true
# WECHAT_NIGHTLY_STOP_TIME=23:30
# WECHAT_NIGHTLY_START_TIME=01:30

# WeChat Auto-Login on Startup/Restart
# ENABLE_WECHAT_AUTO_LOGIN=true
# AUTO_LOGIN_DELAY=3



